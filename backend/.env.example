DATABASE_URL="postgresql://usuari:contrasenya@localhost:5432/aitasa_db?schema=public"
JWT_SECRET="canvia_aquest_secret_per_un_de_segur"
PORT=4000

# Claus VAPID per a notificacions push web.
# Genera-les UNA VEGADA amb: npx web-push generate-vapid-keys
# i enganxa aquí el resultat. No les canviïs després, o els usuaris
# hauran de tornar a activar les notificacions.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# "Modificacions APP" (pestanya d'IA pels encarregats que proposa canvis de codi).
# Opcional: sense aquestes variables la pestanya mostra un avís i no deixa demanar canvis.
IA_ANTHROPIC_API_KEY=""
# Fine-grained personal access token de GitHub, amb permisos "Contents: Read and
# write" i "Pull requests: Read and write" limitats NOMÉS a aquest repositori.
IA_GITHUB_TOKEN=""
# Format "propietari/repositori", p.ex. aitasa-program/general
IA_GITHUB_REPO=""
# Branca on es fan els commits (per defecte "main" si es deixa buit).
IA_GITHUB_BRANCH=""
