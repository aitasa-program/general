// Schema de base de dades per a l'app de gestió de magatzem AITASA

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  TREBALLADOR
  ENCARREGAT
}

enum EstatTasca {
  PENDENT
  EN_CURS
  FETA
}

enum RepeticioTasca {
  UNIC
  DIARIA
  SETMANAL
}

enum Prioritat {
  BAIXA
  MITJANA
  ALTA
}

enum FrequenciaChecklist {
  DIARIA
  SETMANAL
  PUNTUAL
}

enum Repeticio {
  UNIC
  DIARI
  SETMANAL
}

enum TipusMoviment {
  ENTRADA
  SORTIDA
}

enum EstatMoviment {
  PENDENT
  CONFIRMAT
  REBUTJAT
}

enum PropietatVehicle {
  PROPI
  RENTING
}

enum TipusRegistreReten {
  EXTRA_NORMAL
  EXTRA_NOCTURNA
  EXTRA_FESTIU
  TRUCADA
}

model Usuari {
  id            String   @id @default(uuid())
  nom           String
  usuari        String   @unique
  contrasenya   String
  rol           Rol
  actiu         Boolean  @default(true)
  creatEl       DateTime @default(now())

  tasquesAssignades   Tasca[]            @relation("TasquesAssignades")
  tasquesCreades      Tasca[]            @relation("TasquesCreades")
  checklistsAssignades Checklist[]       @relation("ChecklistsAssignades")
  recordatoris        Recordatori[]
  respostesFormulari  RespostaFormulari[]
  movimentsRegistrats MovimentInventari[] @relation("MovimentsRegistrats")
  movimentsConfirmats MovimentInventari[] @relation("MovimentsConfirmats")
  subscripcionsPush   SubscripcioPush[]
  setmanesDeReten     Reten[]
  setmanesDeQuinzena  Quinzena[]
  setmanesDeQuinzenaB QuinzenaB[]
  fitxatges           Fitxatge[]
  registresReten      RegistreReten[]
}

model Tasca {
  id              String         @id @default(uuid())
  titol           String
  descripcio      String?
  assignatsA         Usuari[]       @relation("TasquesAssignades")
  assignatAlReten    Boolean        @default(false)
  assignatAQuinzena  Boolean        @default(false)
  assignatAQuinzenaB Boolean        @default(false)
  creatPer        Usuari         @relation("TasquesCreades", fields: [creatPerId], references: [id])
  creatPerId      String
  estat           EstatTasca     @default(PENDENT)
  dataLimit       DateTime?
  repeticio       RepeticioTasca @default(UNIC)
  prioritat       Prioritat      @default(MITJANA)
  creatEl         DateTime       @default(now())
}

model Checklist {
  id              String              @id @default(uuid())
  nom             String
  assignatA         Usuari?             @relation("ChecklistsAssignades", fields: [assignatAId], references: [id])
  assignatAId       String?
  assignatAlReten   Boolean             @default(false)
  assignatAQuinzena Boolean             @default(false)
  assignatAQuinzenaB Boolean            @default(false)
  frequencia      FrequenciaChecklist @default(PUNTUAL)
  data            DateTime            @default(now())
  items           ChecklistItem[]
}

model ChecklistItem {
  id          String    @id @default(uuid())
  checklist   Checklist @relation(fields: [checklistId], references: [id])
  checklistId String
  text        String
  marcat      Boolean   @default(false)
  ordre       Int
}

model Recordatori {
  id            String     @id @default(uuid())
  text          String
  usuari        Usuari     @relation(fields: [usuariId], references: [id])
  usuariId      String
  dataHora      DateTime
  repeticio     Repeticio  @default(UNIC)
  enviat        Boolean    @default(false)
}

// Guarda la subscripció push del navegador de cada dispositiu de l'usuari,
// perquè el servidor pugui enviar-li notificacions encara que no tingui la web oberta.
model SubscripcioPush {
  id        String   @id @default(uuid())
  usuari    Usuari   @relation(fields: [usuariId], references: [id])
  usuariId  String
  endpoint  String   @unique
  p256dh    String
  auth      String
  creatEl   DateTime @default(now())
}

model Formulari {
  id        String              @id @default(uuid())
  nom       String
  camps     Json // definició dinàmica dels camps del formulari
  creatEl   DateTime            @default(now())
  respostes RespostaFormulari[]
}

model RespostaFormulari {
  id           String    @id @default(uuid())
  formulari    Formulari @relation(fields: [formulariId], references: [id])
  formulariId  String
  usuari       Usuari    @relation(fields: [usuariId], references: [id])
  usuariId     String
  valors       Json
  dataEl       DateTime  @default(now())
}

model TipusProducte {
  id        String     @id @default(uuid())
  nom       String     @unique
  creatEl   DateTime   @default(now())
  productes Producte[]
}

model Producte {
  id           String         @id @default(uuid())
  nom          String
  codi         String         @unique
  tipus        TipusProducte? @relation(fields: [tipusId], references: [id])
  tipusId      String?
  quantitat    Int            @default(0)
  ubicacio     String?
  estanteria   Int?
  stockMinim   Int            @default(0)

  moviments    MovimentInventari[]
}

// Directori de comptadors: cada empresa/zona té els seus comptadors.
// La lectura i gestió real es fa a l'aplicació externa de comptadors;
// aquí només es porta l'organització de quins comptadors hi ha i on.
model ZonaComptador {
  id         String      @id @default(uuid())
  nom        String      @unique
  creatEl    DateTime    @default(now())
  comptadors Comptador[]
}

model Comptador {
  id      String        @id @default(uuid())
  nom     String
  zona    ZonaComptador @relation(fields: [zonaId], references: [id])
  zonaId  String
  creatEl DateTime      @default(now())
}

// El retén canvia cada dilluns a les 8:00. setmanaInici sempre guarda
// el dilluns a les 8:00 que marca l'inici d'aquella setmana de retén.
model Reten {
  id           String   @id @default(uuid())
  setmanaInici DateTime @unique
  usuari       Usuari   @relation(fields: [usuariId], references: [id])
  usuariId     String
  creatEl      DateTime @default(now())
}

// La quinzena és un segon torn setmanal independent del retén (p.ex. un
// alterna amb l'altre: una setmana ets retén, la següent ets de quinzena).
// Fa servir el mateix concepte de setmana (dilluns 8:00) que el retén.
model Quinzena {
  id           String   @id @default(uuid())
  setmanaInici DateTime @unique
  usuari       Usuari   @relation(fields: [usuariId], references: [id])
  usuariId     String
  creatEl      DateTime @default(now())
}

// La quinzena B és un tercer torn setmanal, totalment independent del
// retén i de la quinzena (mateixa idea de setmana, dilluns 8:00).
model QuinzenaB {
  id           String   @id @default(uuid())
  setmanaInici DateTime @unique
  usuari       Usuari   @relation(fields: [usuariId], references: [id])
  usuariId     String
  creatEl      DateTime @default(now())
}

// Flota de vehicles de l'empresa (propis o de renting), amb les properes
// dates d'ITV i de revisió. La gestió és només per a encarregats; si cal
// que algú vagi a passar-la, es crea una Tasca normal assignada a qui toqui.
model Vehicle {
  id              String           @id @default(uuid())
  matricula       String           @unique
  marca           String?
  model           String?
  propietat       PropietatVehicle
  empresaRenting  String?
  proximaItv      DateTime?
  proximaRevisio  DateTime?
  notes           String?
  creatEl         DateTime         @default(now())
}

// Fitxatge manual de la jornada laboral: l'usuari apunta les hores que ha
// treballat (no es registra l'hora real en el moment de fitxar), el lloc
// de treball i què ha fet, per portar el control de l'horari.
model Fitxatge {
  id         String   @id @default(uuid())
  usuari     Usuari   @relation(fields: [usuariId], references: [id])
  usuariId   String
  entrada    DateTime
  sortida    DateTime
  lloc       String
  descripcio String?
  creatEl    DateTime @default(now())
}

// Registre d'hores extres i trucades de qui està de retén, per portar
// el compte de cara a nòmina: hores extres normals, nocturnes, de dies
// festius, i trucades ateses fora d'hores.
model RegistreReten {
  id        String             @id @default(uuid())
  usuari    Usuari             @relation(fields: [usuariId], references: [id])
  usuariId  String
  tipus     TipusRegistreReten
  data      DateTime
  horaInici DateTime
  horaFi    DateTime
  quantitat Float // hores calculades automàticament (horaFi - horaInici)
  notes     String?
  creatEl   DateTime           @default(now())
}

model MovimentInventari {
  id                String        @id @default(uuid())
  producte          Producte      @relation(fields: [producteId], references: [id])
  producteId        String
  tipus             TipusMoviment
  quantitat         Int
  usuariRegistra     Usuari        @relation("MovimentsRegistrats", fields: [usuariRegistraId], references: [id])
  usuariRegistraId   String
  estat             EstatMoviment @default(PENDENT)
  confirmatPer      Usuari?       @relation("MovimentsConfirmats", fields: [confirmatPerId], references: [id])
  confirmatPerId    String?
  dataRegistre      DateTime      @default(now())
  dataConfirmacio   DateTime?
}
