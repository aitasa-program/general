// Schema de base de dades per a l'app de gestió de magatzem AITASA

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  TREBALLADOR
  ENCARREGAT
}

enum EstatTasca {
  PENDENT
  EN_CURS
  FETA
}

enum RepeticioTasca {
  UNIC
  DIARIA
  SETMANAL
}

enum Prioritat {
  BAIXA
  MITJANA
  ALTA
}

enum FrequenciaChecklist {
  DIARIA
  SETMANAL
  PUNTUAL
}

enum Repeticio {
  UNIC
  DIARI
  SETMANAL
}

enum TipusMoviment {
  ENTRADA
  SORTIDA
}

enum EstatMoviment {
  PENDENT
  CONFIRMAT
  REBUTJAT
}

enum PropietatVehicle {
  PROPI
  RENTING
}

enum TipusRegistreReten {
  EXTRA_NORMAL
  EXTRA_NOCTURNA
  EXTRA_FESTIU
  TRUCADA
}

model Usuari {
  id            String   @id @default(uuid())
  nom           String
  usuari        String   @unique
  contrasenya   String
  rol           Rol
  actiu         Boolean  @default(true)
  creatEl       DateTime @default(now())

  tasquesAssignades   Tasca[]            @relation("TasquesAssignades")
  tasquesCreades      Tasca[]            @relation("TasquesCreades")
  checklistsAssignades Checklist[]       @relation("ChecklistsAssignades")
  recordatoris        Recordatori[]
  respostesFormulari  RespostaFormulari[]
  movimentsRegistrats MovimentInventari[] @relation("MovimentsRegistrats")
  movimentsConfirmats MovimentInventari[] @relation("MovimentsConfirmats")
  productesCreats     Producte[]          @relation("ProductesCreats")
  productesConfirmats Producte[]          @relation("ProductesConfirmats")
  checklistsHistoriquesFetes ChecklistHistoric[] @relation("ChecklistHistoricResponsable")
  propostesIACreades    PropostaIA[]        @relation("PropostesIACreades")
  propostesIAAplicades  PropostaIA[]        @relation("PropostesIAAplicades")
  subscripcionsPush   SubscripcioPush[]
  setmanesDeReten     Reten[]
  setmanesDeQuinzena  Quinzena[]
  setmanesDeQuinzenaB QuinzenaB[]
  fitxatges           Fitxatge[]
  registresReten      RegistreReten[]
  controlsArxivats    RegistreControl[]
  documentsPujats     DocumentArxiu[]
}

model PlantillaControl {
  id        String @id @default(uuid())
  nom       String
  camps     Json
  versio    Int @default(1)
  activa    Boolean @default(true)
  creatEl   DateTime @default(now())
  registres RegistreControl[]
}

model FullControlSetmanal {
  id       String @id @default(uuid())
  tipus    String
  setmana  String
  versio   Int @default(0)
  revisions RevisioControlSetmanal[]
  @@unique([tipus, setmana])
}

model RevisioControlSetmanal {
  id           String @id
  fullId       String
  full         FullControlSetmanal @relation(fields: [fullId], references: [id], onDelete: Restrict)
  versio       Int
  dades        Json
  autorId      String
  autorNom     String
  creatEl      DateTime @default(now())
  motiu        String?
  pdf          Bytes
  sha256       String
  peticioHash  String
  @@unique([fullId, versio])
}

// El PDF i les dades són una instantània; les correccions creen un altre registre.
model RegistreControl {
  id                   String @id
  plantillaId          String
  plantilla            PlantillaControl @relation(fields: [plantillaId], references: [id], onDelete: Restrict)
  nom                  String
  versio               Int
  camps                Json
  valors               Json
  dia                  String
  autorId              String?
  autor                Usuari? @relation(fields: [autorId], references: [id], onDelete: SetNull)
  autorNom             String
  creatEl              DateTime @default(now())
  pdf                  Bytes
  sha256               String
  empremtaSollicitud    String
  rectificaId          String? @unique
  rectifica            RegistreControl? @relation("RectificacioControl", fields: [rectificaId], references: [id], onDelete: Restrict)
  rectificacio         RegistreControl? @relation("RectificacioControl")
  motiu                String?

  @@index([dia, creatEl])
  @@index([plantillaId, dia])
}

model CarpetaDocument {
  id        String @id @default(uuid())
  nom       String @unique
  creatEl   DateTime @default(now())
  documents DocumentArxiu[]
}

model DocumentArxiu {
  id          String @id @default(uuid())
  carpetaId   String
  carpeta     CarpetaDocument @relation(fields: [carpetaId], references: [id], onDelete: Restrict)
  nom         String
  nomFitxer   String
  mime        String
  mida        Int
  contingut   Bytes
  sha256      String
  autorId     String?
  autor       Usuari? @relation(fields: [autorId], references: [id], onDelete: SetNull)
  autorNom    String
  creatEl     DateTime @default(now())

  @@index([carpetaId, creatEl])
}

model Tasca {
  id              String         @id @default(uuid())
  titol           String
  descripcio      String?
  assignatsA         Usuari[]       @relation("TasquesAssignades")
  assignatAlReten    Boolean        @default(false)
  assignatAQuinzena  Boolean        @default(false)
  assignatAQuinzenaB Boolean        @default(false)
  creatPer        Usuari         @relation("TasquesCreades", fields: [creatPerId], references: [id])
  creatPerId      String
  estat           EstatTasca     @default(PENDENT)
  dataLimit       DateTime?
  repeticio       RepeticioTasca @default(UNIC)
  prioritat       Prioritat      @default(MITJANA)
  creatEl         DateTime       @default(now())
}

model Checklist {
  id              String              @id @default(uuid())
  nom             String
  assignatA         Usuari?             @relation("ChecklistsAssignades", fields: [assignatAId], references: [id])
  assignatAId       String?
  assignatAlReten   Boolean             @default(false)
  assignatAQuinzena Boolean             @default(false)
  assignatAQuinzenaB Boolean            @default(false)
  frequencia      FrequenciaChecklist @default(PUNTUAL)
  data            DateTime            @default(now())
  items           ChecklistItem[]
  historics       ChecklistHistoric[]
}

model ChecklistItem {
  id          String    @id @default(uuid())
  checklist   Checklist @relation(fields: [checklistId], references: [id])
  checklistId String
  text        String
  marcat      Boolean   @default(false)
  ordre       Int
}

// Còpia arxivada d'una checklist recurrent (diària/setmanal) just abans que el
// planificador la reinicïi per al cicle següent, perquè es pugui consultar
// qui va fer què en cicles anteriors (ex: setmanes passades de RETÉN).
model ChecklistHistoric {
  id                 String    @id @default(uuid())
  checklist          Checklist? @relation(fields: [checklistId], references: [id], onDelete: SetNull)
  checklistId        String?
  nom                String
  data               DateTime
  assignatAlReten    Boolean   @default(false)
  assignatAQuinzena  Boolean   @default(false)
  assignatAQuinzenaB Boolean   @default(false)
  responsable        Usuari?   @relation("ChecklistHistoricResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  responsableId      String?
  responsableNom     String?
  items              Json
  arxivatEl          DateTime  @default(now())
}

model Recordatori {
  id            String     @id @default(uuid())
  text          String
  usuari        Usuari     @relation(fields: [usuariId], references: [id])
  usuariId      String
  dataHora      DateTime
  repeticio     Repeticio  @default(UNIC)
  enviat        Boolean    @default(false)
}

// Guarda la subscripció push del navegador de cada dispositiu de l'usuari,
// perquè el servidor pugui enviar-li notificacions encara que no tingui la web oberta.
model SubscripcioPush {
  id        String   @id @default(uuid())
  usuari    Usuari   @relation(fields: [usuariId], references: [id])
  usuariId  String
  endpoint  String   @unique
  p256dh    String
  auth      String
  creatEl   DateTime @default(now())
}

model Formulari {
  id        String              @id @default(uuid())
  nom       String
  camps     Json // definició dinàmica dels camps del formulari
  creatEl   DateTime            @default(now())
  respostes RespostaFormulari[]
}

model RespostaFormulari {
  id           String    @id @default(uuid())
  formulari    Formulari @relation(fields: [formulariId], references: [id])
  formulariId  String
  usuari       Usuari    @relation(fields: [usuariId], references: [id])
  usuariId     String
  valors       Json
  dataEl       DateTime  @default(now())
}

model TipusProducte {
  id        String     @id @default(uuid())
  nom       String     @unique
  creatEl   DateTime   @default(now())
  productes Producte[]
}

model Producte {
  id              String         @id @default(uuid())
  nom             String
  codi            String         @unique
  tipus           TipusProducte? @relation(fields: [tipusId], references: [id])
  tipusId         String?
  quantitat       Int            @default(0)
  ubicacio        String?
  estanteria      Int?
  stockMinim      Int            @default(0)
  estat           EstatMoviment  @default(CONFIRMAT)
  creatPer        Usuari?        @relation("ProductesCreats", fields: [creatPerId], references: [id])
  creatPerId      String?
  confirmatPer    Usuari?        @relation("ProductesConfirmats", fields: [confirmatPerId], references: [id])
  confirmatPerId  String?
  creatEl         DateTime       @default(now())
  dataConfirmacio DateTime?

  moviments    MovimentInventari[]
  fotos        FotoProducte[]
}

model FotoProducte {
  id         String @id
  producteId String
  producte   Producte @relation(fields: [producteId], references: [id], onDelete: Cascade)
  nom        String
  mime       String
  dades      Bytes
  creatEl    DateTime @default(now())
  @@index([producteId])
}

// Directori de comptadors: cada empresa/zona té els seus comptadors.
// La lectura i gestió real es fa a l'aplicació externa de comptadors;
// aquí només es porta l'organització de quins comptadors hi ha i on.
model ZonaComptador {
  id         String      @id @default(uuid())
  nom        String      @unique
  creatEl    DateTime    @default(now())
  comptadors Comptador[]
}

model Comptador {
  id      String        @id @default(uuid())
  nom     String
  zona    ZonaComptador @relation(fields: [zonaId], references: [id])
  zonaId  String
  creatEl DateTime      @default(now())
}

// El retén canvia cada dilluns a les 8:00. setmanaInici sempre guarda
// el dilluns a les 8:00 que marca l'inici d'aquella setmana de retén.
model Reten {
  id           String   @id @default(uuid())
  setmanaInici DateTime @unique
  usuari       Usuari   @relation(fields: [usuariId], references: [id])
  usuariId     String
  creatEl      DateTime @default(now())
}

// La quinzena és un segon torn setmanal independent del retén (p.ex. un
// alterna amb l'altre: una setmana ets retén, la següent ets de quinzena).
// Fa servir el mateix concepte de setmana (dilluns 8:00) que el retén.
model Quinzena {
  id           String   @id @default(uuid())
  setmanaInici DateTime @unique
  usuari       Usuari   @relation(fields: [usuariId], references: [id])
  usuariId     String
  creatEl      DateTime @default(now())
}

// La quinzena B és un tercer torn setmanal, totalment independent del
// retén i de la quinzena (mateixa idea de setmana, dilluns 8:00).
model QuinzenaB {
  id           String   @id @default(uuid())
  setmanaInici DateTime @unique
  usuari       Usuari   @relation(fields: [usuariId], references: [id])
  usuariId     String
  creatEl      DateTime @default(now())
}

// Flota de vehicles de l'empresa (propis o de renting), amb les properes
// dates d'ITV i de revisió. La gestió és només per a encarregats; si cal
// que algú vagi a passar-la, es crea una Tasca normal assignada a qui toqui.
model Vehicle {
  id              String           @id @default(uuid())
  matricula       String           @unique
  marca           String?
  model           String?
  propietat       PropietatVehicle
  empresaRenting  String?
  proximaItv      DateTime?
  proximaRevisio  DateTime?
  notes           String?
  creatEl         DateTime         @default(now())
}

// Llocs de treball que un encarregat manté per triar-los en fitxar (ex:
// Magatzem, Bonavista, Oficina...).
model LlocTreball {
  id        String     @id @default(uuid())
  nom       String     @unique
  creatEl   DateTime   @default(now())
  fitxatges Fitxatge[]
}

// Franges horàries que un encarregat manté (ex: "Matí (4h)", "Jornada
// completa (8h)") perquè en fitxar només calgui triar-ne una en lloc
// d'indicar hora d'entrada i sortida.
model FranjaHoraria {
  id        String     @id @default(uuid())
  nom       String     @unique
  hores     Float
  creatEl   DateTime   @default(now())
  fitxatges Fitxatge[]
}

// Fitxatge manual de la jornada laboral: l'usuari indica el dia, quina
// franja horària ha fet, el lloc de treball i què ha fet (obligatori),
// per portar el control de l'horari.
model Fitxatge {
  id              String        @id @default(uuid())
  usuari          Usuari        @relation(fields: [usuariId], references: [id])
  usuariId        String
  data            DateTime
  llocTreball     LlocTreball   @relation(fields: [llocTreballId], references: [id])
  llocTreballId   String
  franjaHoraria   FranjaHoraria? @relation(fields: [franjaHorariaId], references: [id])
  franjaHorariaId String?
  hores           Float? // còpia de franjaHoraria.hores en el moment de fitxar, si se n'ha triat una
  descripcio      String
  creatEl         DateTime      @default(now())
}

// Registre d'hores extres i trucades de qui està de retén, per portar
// el compte de cara a nòmina: hores extres normals, nocturnes, de dies
// festius, i trucades ateses fora d'hores.
model RegistreReten {
  id        String             @id @default(uuid())
  usuari    Usuari             @relation(fields: [usuariId], references: [id])
  usuariId  String
  tipus     TipusRegistreReten
  data      DateTime
  horaInici DateTime
  horaFi    DateTime
  quantitat Float // hores calculades automàticament (horaFi - horaInici)
  notes     String?
  creatEl   DateTime           @default(now())
}

model MovimentInventari {
  id                String        @id @default(uuid())
  producte          Producte      @relation(fields: [producteId], references: [id])
  producteId        String
  tipus             TipusMoviment
  quantitat         Int
  usuariRegistra     Usuari        @relation("MovimentsRegistrats", fields: [usuariRegistraId], references: [id])
  usuariRegistraId   String
  estat             EstatMoviment @default(PENDENT)
  confirmatPer      Usuari?       @relation("MovimentsConfirmats", fields: [confirmatPerId], references: [id])
  confirmatPerId    String?
  dataRegistre      DateTime      @default(now())
  dataConfirmacio   DateTime?
}

model Mostra {
 id String @id @default(uuid())
 grup String
 titol String
 data String
 notes String @default("")
 intervalDies Int @default(0)
 feta Boolean @default(false)
 clau String @unique
 creatEl DateTime @default(now())
 @@index([data, grup])
}

enum EstatPropostaIA {
  PENDENT
  APLICADA
  REBUTJADA
  ERROR
}

// Petició d'un encarregat a la IA de "Modificacions APP" perquè proposi un canvi
// al codi de l'aplicació. La IA només proposa (fitxers + missatge de commit);
// cal que un encarregat l'apliqui explícitament perquè es faci el commit real
// i es desplegui.
model PropostaIA {
  id             String          @id @default(uuid())
  prompt         String
  // Noms i tipus dels fitxers (fotos/documents) adjuntats a la petició; no es
  // guarda el contingut binari, només serveix per mostrar què es va adjuntar.
  adjunts        Json?
  resum          String
  fitxers        Json
  missatgeCommit String
  estat          EstatPropostaIA @default(PENDENT)
  error          String?
  commitSha      String?
  creatPer       Usuari          @relation("PropostesIACreades", fields: [creatPerId], references: [id])
  creatPerId     String
  aplicatPer     Usuari?         @relation("PropostesIAAplicades", fields: [aplicatPerId], references: [id])
  aplicatPerId   String?
  creatEl        DateTime        @default(now())
  resoltEl       DateTime?
}
